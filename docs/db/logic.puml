@startuml
skinparam linetype ortho
skinparam defaultFontSize 15
skinparam nodesep 10
skinparam ranksep 60
hide empty members
hide circle

entity "Бренд" as Brand {
  ID : integer <<PK>>
  --
  Название : varchar
  Логотип : varchar
}

entity "Категория мотоцикла" as MotoCategory {
  ID : integer <<PK>>
  --
  Название : varchar
}

entity "Категория товара" as ProductCategory {
  ID : integer <<PK>>
  --
  Название : varchar
}

entity "Товар" as Product {
  ID : integer <<PK>>
  --
  ID Категории : bigint <<FK>>
  ID Бренда : bigint <<FK>>
  Название : varchar
  Цена : decimal
  Наличие : integer
  Краткое описание : varchar
  Описание : text
  Опубликован : bool
  Дата создания : datetime
}

entity "Фотография товара" as ProductImage {
  ID : integer <<PK>>
  --
  ID Товара : bigint <<FK>>
  Изображение : varchar
  Подпись : varchar
}

entity "Мотоцикл" as Motorcycle {
  ID Товара : bigint <<PK, FK>>
  --
  ID Категории мотоцикла : bigint <<FK>>
  Год выпуска : integer
  Объём двигателя : integer
  Мощность : integer
  Масса : integer
  Цвет : varchar
}

entity "Экипировка" as Equipment {
  ID Товара : bigint <<PK, FK>>
  --
  ID Типа экипировки : bigint <<FK>>
  Размер : varchar
  Цвет : varchar
}

entity "Тип экипировки" as EquipmentType {
  ID : integer <<PK>>
  --
  Название : varchar
}

entity "Масло" as Oil {
  ID Товара : bigint <<PK, FK>>
  --
  Вязкость : varchar
  Объём : integer
}

entity "Шина" as Tire {
  ID Товара : bigint <<PK, FK>>
  --
  Диаметр : smallint
}

entity "Запчасть" as Part {
  ID Товара : bigint <<PK, FK>>
  --
  ID Типа запчасти : bigint <<FK>>
}

entity "Тип запчасти" as PartType {
  ID : integer <<PK>>
  --
  Название : varchar
}

entity "Аксессуар" as Accessory {
  ID Товара : bigint <<PK, FK>>
  --
  ID Типа аксессуара : bigint <<FK>>
}

entity "Тип аксессуара" as AccessoryType {
  ID : integer <<PK>>
  --
  Название : varchar
}

entity "Заказ" as Order {
  ID : integer <<PK>>
  --
  ID Пользователя : integer <<FK>>
  ФИО : varchar
  Телефон : varchar
  Email : varchar
  Адрес доставки : varchar
  Комментарий : text
  Статус : varchar
  Сумма : decimal
  Дата создания : datetime
}

entity "Позиция заказа" as OrderItem {
  ID : integer <<PK>>
  --
  ID Заказа : bigint <<FK>>
  ID Товара : bigint <<FK>>
  Название (снимок) : varchar
  Цена : decimal
  Количество : integer
}

entity "Пользователь" as User {
  ID : integer <<PK>>
}

entity "Профиль" as Profile {
  ID : integer <<PK>>
  --
  ID Пользователя : integer <<FK>>
  ФИО : varchar
  Телефон : varchar
  Адрес : varchar
}

entity "Код подтверждения" as EmailConfirmation {
  ID : integer <<PK>>
  --
  ID Пользователя : integer <<FK>>
  Код : varchar
  Дата создания : datetime
}

entity "Резервирование" as CheckoutReservation {
  ID : integer <<PK>>
  --
  ID Товара : bigint <<FK>>
  Ключ сессии : varchar
  Количество : integer
  Срок действия : datetime
  Дата создания : datetime
}

entity "Отзыв" as Review {
  ID : integer <<PK>>
  --
  Имя автора : varchar
  Оценка : smallint
  Текст : text
  Дата создания : datetime
}

entity "Партнёр" as Partner {
  ID : integer <<PK>>
  --
  Название : varchar
  Логотип : varchar
}

Brand ||--o{ Product
ProductCategory ||--o{ Product
Product ||--o{ ProductImage
Product ||--o{ OrderItem
Product ||--o{ CheckoutReservation
Product ||--|| Motorcycle
Product ||--|| Equipment
Product ||--|| Oil
Product ||--|| Tire
Product ||--|| Part
Product ||--|| Accessory
MotoCategory ||--o{ Motorcycle
EquipmentType ||--o{ Equipment
PartType ||--o{ Part
AccessoryType ||--o{ Accessory
Order ||--|{ OrderItem
User ||--o{ Order
User ||--|| Profile
User ||--|| EmailConfirmation

' Невидимые стрелки лишь для выравнивая диаграммы
Motorcycle -[hidden]d- Oil
Oil -[hidden]d- Part
Equipment -[hidden]d- Tire
Tire -[hidden]d- Accessory
MotoCategory -[hidden]d- PartType
EquipmentType -[hidden]d- AccessoryType
Brand -[hidden]d- ProductCategory
Order -[hidden]d- OrderItem
OrderItem -[hidden]d- CheckoutReservation
User -[hidden]d- Profile
Profile -[hidden]d- EmailConfirmation
ProductImage -[hidden]d- Review
Review -[hidden]d- Partner

@enduml
